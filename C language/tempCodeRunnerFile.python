import turtle
import colorsys

# Setup the window
t = turtle.Turtle()
s = turtle.Screen()
s.bgcolor("black")
t.speed(0)  # Fastest speed

n = 36  # Number of loops
h = 0   # Hue (color)

# Draw the spiral
print("Drawing spiral... check the new window!")
for i in range(300):
    c = colorsys.hsv_to_rgb(h, 1, 0.8)
    h += 1/n
    t.color(c)
    t.left(10)
    for j in range(5):
        t.forward(200)
        t.left(144)

turtle.done()